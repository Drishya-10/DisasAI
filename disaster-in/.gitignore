# ============================================================
#  Emergency AI Dispatch System — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.pycache

# ── Virtual Environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/
.env/
virtualenv/

# ── Large ML / Model Files ───────────────────────────────────
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.pkl
*.pickle
*.bin
*.safetensors
*.weights
models/
checkpoints/

# ── Audio Files (Generated on first run — do NOT commit) ─────
data/samples/*.wav
data/processed/
*.wav
*.mp3
*.ogg
*.webm
*.m4a
*.flac

# ── Logs & Temp ──────────────────────────────────────────────
*.log
*.tmp
*.temp
logs/
tmp/
temp/

# ── OS / System ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDE & Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── Jupyter Notebooks ────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Environment / Secrets ────────────────────────────────────
.env
.env.local
.env.production
secrets.py
*.key

# ── Build / Dist ─────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
site-packages/

# ── FastAPI / Uvicorn ─────────────────────────────────────────
*.pid

# ── Coverage & Testing ────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.tox/

# ── Node (if frontend tooling added later) ───────────────────
node_modules/
package-lock.json
